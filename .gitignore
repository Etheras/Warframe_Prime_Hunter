# ─── Digital Extremes' game data is NOT redistributed here ───────────────
# It is downloaded and rebuilt on demand by tools/build_data.py — locally for
# you, and in CI for the published site. Keeping it out means this repo stays
# source-only and every build pulls fresh data straight from DE.
data/vorframe-data.js
data/vorframe-data.json

# HTTP cache and freshness state — regenerated by tools/build_data.py
.cache/

# single-file build output
dist/

# python
__pycache__/
*.pyc

# editor / tool config — local to whoever is working on it
.claude/
.vscode/
.idea/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
